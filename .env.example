# Shell environment variables take precedence over this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HARNESS2_SOLVER_MODEL=
# Defaults to HARNESS2_SOLVER_MODEL when blank.
HARNESS2_IMPROVER_MODEL=
HARNESS2_JUDGE_MODEL=
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=

# Optional local OpenAI-compatible server; set both URL and server model alias.
# Supplies local solver/improver/JobBench judge defaults when those are blank.
# Example: URL=http://127.0.0.1:8087/v1 and MODEL=local-model
HARNESS2_LOCAL_BASE_URL=
HARNESS2_LOCAL_MODEL=
HARNESS2_LOCAL_API_KEY=
HARNESS2_LOCAL_CONTEXT=32768
HARNESS2_LOCAL_OUTPUT=4096

# Optional JobBench judge controls. Blank uses the selected profile's defaults.
HARNESS2_JUDGE_WORKERS=
HARNESS2_JUDGE_OUTPUT=
HARNESS2_JUDGE_RUBRIC_TIMEOUT=
HARNESS2_JUDGE_TIMEOUT=

# Optional Codex Responses endpoint (harness2-bridge prints these settings).
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_API_KEY=
HARNESS2_CODEX_MODEL=
HARNESS2_CODEX_CONTAINER_URL=

# Optional output location. Windows example: C:/harness2-runs
HARNESS2_RUNS_DIR=
