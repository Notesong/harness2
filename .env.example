# Shell environment variables take precedence over this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HARNESS2_SOLVER_MODEL=
# Defaults to HARNESS2_SOLVER_MODEL when blank.
HARNESS2_IMPROVER_MODEL=
HARNESS2_JUDGE_MODEL=

# Optional Codex Responses endpoint (harness2-bridge prints these settings).
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_API_KEY=
HARNESS2_CODEX_MODEL=
HARNESS2_CODEX_CONTAINER_URL=

# Optional output location. Windows example: C:/harness2-runs
HARNESS2_RUNS_DIR=
